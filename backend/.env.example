# ---------------------------------------------------------------------------
# AI Purchasing Agent — backend configuration
# Copy this file to `.env` and fill in values. NEVER commit a real .env.
# ---------------------------------------------------------------------------

# Which LLM drives the agent's reasoning loop.
#   stub      -> deterministic, offline agent (no API key needed). DEFAULT.
#   anthropic -> Claude via the Anthropic SDK (requires ANTHROPIC_API_KEY)
#   openai    -> GPT via the OpenAI SDK      (requires OPENAI_API_KEY)
LLM_PROVIDER=stub

# Anthropic (only needed when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# OpenAI (only needed when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Max tool-use iterations before the agent loop gives up (safety bound).
AGENT_MAX_STEPS=12

# SQLite database location (relative to the backend/ directory).
DATABASE_URL=sqlite:///./purchasing.db
